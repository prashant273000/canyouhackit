{
  "manifest_version": 3,
  "name": "AI Feed Shield",
  "version": "1.0",
  "description": "Personalized AI safety layer for supported websites.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*", 
    "*://*.reddit.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*", 
        "*://*.reddit.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*"
      ],
      "css": ["content.css"],
      "js": ["content.js", "reddit_adapter.js", "twitter_adapter.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "aifeedshield@canyouhackit.org",
      "strict_min_version": "109.0"
    }
  }
}
